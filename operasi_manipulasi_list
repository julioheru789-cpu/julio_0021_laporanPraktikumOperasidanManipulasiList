#operasi list
print("\noperasi list")
data = ["ucup", "adit", "dudung"]

#mengambil data dari list
data_0 = data[0]
print(f"data pertama (index 0) = {data_0}")

data_1 = data[1]
print(f"data kedua (index 1) = {data_1}")

data_2 = data[2]
print(f"data ketiga (index kedua) = {data_2}")

data_terakhir = data[-1]
print(f"data terakhir adalah {data_terakhir}")

#menambil info jumlah data dalam list
panjang_data = len(data)
print(f"panjang data = {panjang_data}")

#manipulasi data list

#data.insert(posisi, item)

data.insert(0,"asep")
print(f"data sesudah ditambah = \n{data}")
panjang_data = len(data)
print(f"panjang data = {panjang_data}")

#menambah item di akhir list
data.append("ririn")
print(f"data ditambah lagi = {data}")

#menambahkan list dengan list
data_baru = ["luffy", "naruto", "itachi"]
data.extend(data_baru)
print(f"data semuanya adalah {data}")

#mengubah data
data[2] = "jarwo"
print(f"data rubah adalah {data}")

#menghapus data
data.remove("ucup")
print(f"data sesudah di remove = {data}")

#menghapus data paling belakang
data.pop()
print(f"data setelah dihapus data belakangnya = {data}")

